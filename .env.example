# Configuration file for local ports and endpoint settings.
# Copy this file to .env to customize local service ports.

# Database Credentials (PostgreSQL)
POSTGRES_USER=journey
POSTGRES_PASSWORD=journey_pass
POSTGRES_DB=journeydb
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Analytics Database (ClickHouse)
CLICKHOUSE_USER=journey
CLICKHOUSE_PASSWORD=journey_pass
CLICKHOUSE_DB=journeydb
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9009

# Kafka & Schema Registry
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
SCHEMA_REGISTRY_PORT=8081
SCHEMA_REGISTRY_URL=http://127.0.0.1:8081

# MinIO Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_CONSOLE_URL=http://127.0.0.1:9001
MINIO_BUCKET_ARTIFACTS=journey-artifacts
MINIO_BUCKET_STATIC_LISTS=journey-static-lists

# Temporal Orchestrator
TEMPORAL_PORT=7233
TEMPORAL_HOST_PORT=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_UI_PORT=8233
TEMPORAL_UI_URL=http://127.0.0.1:8233

# Mailpit Email Service
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_UI_URL=http://127.0.0.1:8025

# Service Ports & Endpoints
CONTROL_API_PORT=8087
EVENT_INGRESS_PORT=8088
OUTCOME_INGRESS_PORT=8085
FAKE_PROVIDER_PORT=8089
FAKE_PROVIDER_ENDPOINT=http://127.0.0.1:8089
FRONTEND_PORT=3002
