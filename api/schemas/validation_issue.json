{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://validated-pattern.github.io/journey-platform/schemas/validation_issue.json",
  "title": "ValidationIssue",
  "type": "object",
  "required": [
    "schema_version",
    "issue_id",
    "node_id",
    "severity",
    "code",
    "message",
    "field_path"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "issue_id": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": ["error", "warning", "info"]
    },
    "code": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "field_path": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
