{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://validated-pattern.github.io/journey-platform/schemas/normalized_outcome.json",
  "title": "NormalizedOutcome",
  "type": "object",
  "required": [
    "schema_version",
    "outcome_id",
    "run_id",
    "event_name",
    "value",
    "unit",
    "data_classification",
    "timestamp"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "outcome_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "event_name": {
      "type": "string"
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "type": "string"
    },
    "data_classification": {
      "type": "string",
      "enum": ["PII", "NonPII", "Sensitive"]
    },
    "timestamp": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
