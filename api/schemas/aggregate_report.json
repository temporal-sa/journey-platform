{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://validated-pattern.github.io/journey-platform/schemas/aggregate_report.json",
  "title": "AggregateReport",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "tenant_id",
    "experiment_id",
    "period_start",
    "period_end",
    "metrics",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "report_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "experiment_id": {
      "type": "string"
    },
    "period_start": {
      "type": "string"
    },
    "period_end": {
      "type": "string"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric_name", "total_count", "mean", "weight_basis_points"],
        "properties": {
          "metric_name": { "type": "string" },
          "total_count": { "type": "integer" },
          "mean": { "type": "number" },
          "weight_basis_points": { "type": "integer" },
          "confidence_interval_lower": { "type": "number" },
          "confidence_interval_upper": { "type": "number" }
        },
        "additionalProperties": false
      }
    },
    "generated_at": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
