  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "assignment_id": {
      "type": "string"
    },
    "experiment_id": {
      "type": "string"
    },
    "variant_id": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "assigned_at": {
      "type": "string"
    },
    "exposed_at": {
      "type": "string"
    },
    "weight_basis_points": {
      "type": "integer"
    },
    "data_classification": {
      "type": "string",
      "enum": ["PII", "NonPII", "Sensitive"]
    },
    "context": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
