{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://validated-pattern.github.io/journey-platform/schemas/assignment_exposure.json",
  "title": "AssignmentExposure",
  "type": "object",
  "required": [
    "schema_version",
    "assignment_id",
    "experiment_id",
    "variant_id",
    "subject_id",
    "assigned_at",
    "exposed_at",
    "weight_basis_points",
    "data_classification"
