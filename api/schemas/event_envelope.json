{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://validated-pattern.github.io/journey-platform/schemas/event_envelope.json",
  "title": "EventEnvelope",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "trace_id",
    "event_type",
    "source",
    "timestamp",
    "data_classification",
    "data"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "event_id": {
      "type": "string"
    },
    "trace_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "content_hash": {
      "type": "string"
    },
    "data_classification": {
      "type": "string",
      "enum": ["PII", "NonPII", "Sensitive"]
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
