{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://validated-pattern.github.io/journey-platform/schemas/action_result.json",
  "title": "ActionResult",
  "type": "object",
  "required": [
    "schema_version",
    "action_id",
    "activity_type",
    "status",
    "execution_duration_ms",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "action_id": {
      "type": "string"
    },
    "activity_type": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["success", "failure", "retrying"]
    },
    "output": {
      "type": "object"
    },
    "error_message": {
      "type": "string"
    },
    "execution_duration_ms": {
      "type": "integer"
    },
    "completed_at": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
